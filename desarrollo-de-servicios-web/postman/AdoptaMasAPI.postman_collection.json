{
	"info": {
		"_postman_id": "adoptamas-api-zegel-2026",
		"name": "Zegel - AdoptaMas API (Microservicios)",
		"description": "Colección completa de pruebas para AdoptaMas API con validaciones automáticas, flujos JWT y Transacciones ACID.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 01. Autenticación (AuthService)",
			"item": [
				{
					"name": "Login como Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"if (data.token) {",
									"    pm.environment.set(\"token_admin\", data.token);",
									"    console.log(\"Token Admin guardado correctamente.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@zegel.pe\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
