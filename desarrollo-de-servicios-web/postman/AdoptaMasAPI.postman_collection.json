		{
			"name": "🐾 02. Mascotas (MascotasService)",
			"item": [
				{
					"name": "Listar Mascotas Disponibles (Público)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Respuesta es un arreglo\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/mascotas?estado=Disponible",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"mascotas"
							],
							"query": [
								{
									"key": "estado",
									"value": "Disponible"
								}
							]
						}
					}
				},
				{
					"name": "Obtener Mascota por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/mascotas/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"mascotas",
								"1"
							]
						}
					}
				},
				{
					"name": "Registrar Nueva Mascota (Requiere Token Albergue/Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_albergue}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Toby\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Golden Retriever\",\n  \"edadMeses\": 14,\n  \"sexo\": \"Macho\",\n  \"tamano\": \"Grande\",\n  \"descripcion\": \"Cariñoso y le encanta pasear por parques.\",\n  \"fotoUrl\": \"https://images.unsplash.com/photo-1552053831-71594a27632d\",\n  \"albergueId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/mascotas",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"mascotas"
							]
						}
					}
				}
			]
		},
		{
			"name": "📄 03. Solicitudes y Transacción ACID",
			"item": [
				{
					"name": "Crear Solicitud de Adopción (Adoptante)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token_adoptante}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mascotaId\": 1,\n  \"usuarioId\": 3,\n  \"tienePatio\": true,\n  \"tieneOtrasMascotas\": false,\n  \"motivoAdopcion\": \"Deseo darle un hogar cálido y amoroso a Bobby.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/solicitudes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"solicitudes"
							]
						}
					}
				},
				{
					"name": "Aprobar Solicitud (Transacción ACID)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_albergue}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/solicitudes/1/aprobar",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"solicitudes",
								"1",
								"aprobar"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:6000"
		}
	]
}
