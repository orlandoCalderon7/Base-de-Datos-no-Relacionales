{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "mascotas-route": {
        "ClusterId": "mascotas-cluster",
        "Match": {
          "Path": "/api/mascotas/{**catch-all}"
        }
      },
      "albergues-route": {
        "ClusterId": "mascotas-cluster",
        "Match": {
          "Path": "/api/albergues/{**catch-all}"
        }
      },
      "solicitudes-route": {
        "ClusterId": "mascotas-cluster",
        "Match": {
          "Path": "/api/solicitudes/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:6002"
          }
        }
      },
      "mascotas-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:6001"
          }
        }
      }
    }
  }
}
